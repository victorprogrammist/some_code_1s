
Функция ЗапростьДанные(урл, лог, пас)
	
    п = Найти(урл, "://") + 3;
    ср = Сред(урл, п);
    сл = Найти(ср, "/");
    Если сл = 0 Тогда
        серв = ср;
        путь = "/";
    Иначе
        серв = Лев(ср, сл - 1);
        путь = Сред(ср, сл);
	КонецЕсли;
	
    соединение = Новый HTTPСоединение(
	серв,
	443,
	лог,
	пас,
	, //прокси,
	, //таймаут,
	Новый ЗащищенноеСоединениеOpenSSL);
	
	з = Новый HTTPЗапрос(путь);
	
    ответ = соединение.Получить(з);
	
	стру = новый Структура("КодСостояния", ответ.КодСостояния);
	
    стру.Вставить("Текст", ответ.ПолучитьТелоКакСтроку());
	
	возврат стру;
	
КонецФункции

Функция РазобратьJSONвСтруктуру(ТекстJSON) Экспорт
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Структура = ЗаполнитьСтруктуруИзОтветаJSON(Чтение);	
	Чтение.Закрыть();
	Возврат Структура;
КонецФункции

Функция ЗаполнитьСтруктуруИзОтветаJSON(Знач Чтение) Экспорт
	Результат = Новый Структура;

	ПоследнееИмяРеквизита = Неопределено;
	
	Пока Чтение.Прочитать() Цикл
		Тип = Чтение.ТипТекущегоЗначения;
		Если Тип = ТипЗначенияJSON.НачалоОбъекта И ПоследнееИмяРеквизита<>Неопределено Тогда 
			Результат[ПоследнееИмяРеквизита] = ЗаполнитьСтруктуруИзОтветаJSON(Чтение);
		ИначеЕсли Тип = ТипЗначенияJSON.КонецОбъекта Тогда 
			Возврат Результат;
			ПоследнееИмяРеквизита = Неопределено;
		ИначеЕсли Тип = ТипЗначенияJSON.ИмяСвойства Тогда 
			Результат.Вставить(Чтение.ТекущееЗначение, Неопределено);
			ПоследнееИмяРеквизита = Чтение.ТекущееЗначение;
		ИначеЕсли Тип = ТипЗначенияJSON.Булево или Тип = ТипЗначенияJSON.Строка
			или Тип = ТипЗначенияJSON.Число или Тип = ТипЗначенияJSON.Null Тогда 
			Результат[ПоследнееИмяРеквизита] = Чтение.ТекущееЗначение;
		ИначеЕсли Тип = ТипЗначенияJSON.НачалоМассива Тогда 
			Результат[ПоследнееИмяРеквизита] = ЗаполнитьМассивИзОтветаJSON(Чтение);
		КонецЕсли;
	КонецЦикла;  
		
	Возврат Результат;
КонецФункции 

Функция ЗаполнитьМассивИзОтветаJSON(Знач Чтение)
	Результат = Новый Массив;
	
	Пока Чтение.Прочитать() Цикл
		Тип = Чтение.ТипТекущегоЗначения;
		Если Тип = ТипЗначенияJSON.НачалоОбъекта Тогда 
			Результат.Добавить(ЗаполнитьСтруктуруИзОтветаJSON(Чтение));
		ИначеЕсли Тип = ТипЗначенияJSON.КонецМассива Тогда 
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;  
	
	Возврат Результат;
КонецФункции

Функция   ПутьЗначение(Знач стру, Знач путь)
	
	возврат ячсмТулсы.ПутьЗначение(стру, путь);
	
КонецФункции

Функция   КонвертТипНомер(стру_исх, путь = Неопределено)
	
	Если стру_исх = Неопределено Тогда
		возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(путь) Тогда
		возврат КонвертТипНомер(ПутьЗначение(стру_исх, путь));
	КонецЕсли;
	
	Если ТипЗнч(стру_исх) = Тип("Массив") Тогда
		
		ма = новый Массив;
		Для каждого ит из стру_исх Цикл
			ма.Добавить(КонвертТипНомер(ит));
		КонецЦикла;
		
		возврат ма;
		
	КонецЕсли;
	
	рез = новый Структура;
	рез.Вставить("Тип", ПутьЗначение(стру_исх, "type"));
	рез.Вставить("Номер", ПутьЗначение(стру_исх, "number"));
	
	возврат рез;
	
КонецФункции

Функция   Соед(стр1, стр2)
	
	Если НЕ ЗначениеЗаполнено(стр1) И НЕ ЗначениеЗаполнено(стр2) Тогда
		возврат "";
		
	ИначеЕсли НЕ ЗначениеЗаполнено(стр2) Тогда
		возврат стр1;
		
	ИначеЕсли НЕ ЗначениеЗаполнено(стр1) Тогда
		возврат стр2;
		
	КонецЕсли;
	
	возврат стр1 + " " + стр2;
	
КонецФункции

Функция   МассивТипНомерВСтроку(ма)
	
	Если ма = Неопределено Тогда
		возврат "";
	КонецЕсли;
	
	рез = новый Массив;
	Для Каждого ит из ма Цикл
		рез.Добавить(Соед(ит.Тип, ит.Номер));
	КонецЦикла;
	
	возврат СтрСоединить(рез, ", ");
	
КонецФункции

Функция   КонвертАдрес(стру_исх)
	
	Если стру_исх = Неопределено Тогда
		возврат Неопределено;
	КонецЕсли;
	
	стру = новый Структура;
	
	стру.Вставить("Страна", ПутьЗначение(стру_исх, "country"));
	стру.Вставить("КодСтраны", ПутьЗначение(стру_исх, "countryCode"));
	
	стру.Вставить("Индекс", ПутьЗначение(стру_исх, "PostalCode"));
	
	стру.Вставить("Регион", ПутьЗначение(стру_исх, "area"));
	стру.Вставить("ТипРегиона", ПутьЗначение(стру_исх, "areaType"));
	стру.Вставить("КодРегиона", ПутьЗначение(стру_исх, "areaCode"));
	
	стру.Вставить("Район", ПутьЗначение(стру_исх, "munDistrict"));
	стру.Вставить("ТипРайона", ПутьЗначение(стру_исх, "munDistrictType"));
	
	стру.Вставить("Город", ПутьЗначение(стру_исх, "city"));
	стру.Вставить("ТипГорода", ПутьЗначение(стру_исх, "cityType"));
	
	стру.Вставить("НаселенныйПункт", ПутьЗначение(стру_исх, "locality"));
	стру.Вставить("ТипНаселенногоПункта", ПутьЗначение(стру_исх, "localityType"));
	
	стру.Вставить("Улица", ПутьЗначение(стру_исх, "street"));
	стру.Вставить("ТипУлицы", ПутьЗначение(стру_исх, "streetType"));
	
	стру.Вставить("Дом", ПутьЗначение(стру_исх, "house"));
	стру.Вставить("ТипДома", ПутьЗначение(стру_исх, "houseType"));
	
	стру.Вставить("Корпус", КонвертТипНомер(стру_исх, "buildings"));
	
	стру.Вставить("Квартира", КонвертТипНомер(стру_исх, "apartments"));
	
	стру.Вставить("КорпусСтр", МассивТипНомерВСтроку(стру.Корпус));
	стру.Вставить("КвартираСтр", МассивТипНомерВСтроку(стру.Квартира));
	
	стру.Вставить("Представление", ПутьЗначение(стру_исх, "valueWithPostalCode"));
	
	возврат стру;
	
КонецФункции

Функция   КонвертДату(зн)
	
	Если ТипЗнч(зн) = Тип("Дата") Тогда
		возврат зн;
	ИначеЕсли не ЗначениеЗаполнено(зн) или ТипЗнч(зн) <> Тип("Строка") Тогда
		возврат '00010101';
	КонецЕсли;
	
	г = Лев(зн, 4);
	м = Сред(зн, 6, 2);
	д = Сред(зн, 10, 2);
	
	Попытка
		возврат Дата(Число(г), Число(м), Число(д));
	Исключение
		возврат '00010101';
	КонецПопытки;
	
КонецФункции

Функция   КонвертАдресВСтруктураАдресаДляКонтактнойИнформации(адр) Экспорт
	
	рез = новый Структура;
	
	рез.Вставить("Представление", адр.Представление);
	
	рез.Вставить("Тип", Перечисления.ТипыКонтактнойИнформации.Адрес);
	
	рез.Вставить("Поле1", адр.Индекс);
	рез.Вставить("Поле2", Соед(адр.Регион, адр.ТипРегиона));
	рез.Вставить("Поле3", Соед(адр.ТипРайона, адр.Район));
	рез.Вставить("Поле4", Соед(адр.ТипГорода, адр.Город));
	рез.Вставить("Поле5", Соед(адр.ТипНаселенногоПункта, адр.НаселенныйПункт));
	рез.Вставить("Поле6", Соед(адр.ТипУлицы, адр.Улица));
	рез.Вставить("Поле7", Соед(адр.ТипДома, адр.Дом));
	рез.Вставить("Поле8", адр.КорпусСтр);
	рез.Вставить("Поле9", адр.КвартираСтр);
	
	рез.Вставить("ТипДома", Перечисления.ТипыДомов.Дом);
	рез.Вставить("ТипКорпуса", Перечисления.ТипыКорпусов.Корпус);
	рез.Вставить("ТипКвартиры", Перечисления.ТипыКвартир.Квартира);
	
	рез.Вставить("ячсмЗагруженоИзИнтернета", Истина);
	
	возврат рез;
	
КонецФункции

Функция   КонвертФорматЮрЛицо(стру_исх)
	
	стру = новый Структура;
	стру.Вставить("Ошибка", "");
	
	стру.Вставить("ИНН", ПутьЗначение(стру_исх, "inn"));
	стру.Вставить("КПП", ПутьЗначение(стру_исх, "kpp.value"));
	стру.Вставить("ОГРН", ПутьЗначение(стру_исх, "ogrn"));
	стру.Вставить("ДатаРегистрации", КонвертДату(ПутьЗначение(стру_исх, "registrationDate")));
	
	стру.Вставить("ПолноеНаименование", ПутьЗначение(стру_исх, "name.fullName"));
	стру.Вставить("Наименование", ПутьЗначение(стру_исх, "name.commonName"));
	
	стру.Вставить("Адрес", КонвертАдрес(ПутьЗначение(стру_исх, "address")));
	
	стру.Вставить("КодРегиона", ПутьЗначение(стру_исх, "address.areaCode"));
	
	возврат стру;
	
КонецФункции

Функция   КонвертФорматФизЛицо(стру_исх)
	
	стру = новый Структура;
	стру.Вставить("Ошибка", "");
	
	стру.Вставить("ИНН", ПутьЗначение(стру_исх, "inn"));
	стру.Вставить("ОГРН", ПутьЗначение(стру_исх, "registrationInfo.ogrn"));
	стру.Вставить("ДатаРегистрации", КонвертДату(ПутьЗначение(стру_исх, "registrationInfo.registrationDate")));
	
	фио = ПутьЗначение(стру_исх, "person.fio");
	фио0 = ОбщегоНазначения.ФамилияИнициалыФизЛица(фио);
	тп0 = ПутьЗначение(стру_исх, "registrationInfo.typeName");
	тп1 = ПутьЗначение(стру_исх, "registrationInfo.typeFullName");
	
	стру.Вставить("ПолноеНаименование", тп0 + " " + фио);
	стру.Вставить("Наименование", тп0 + " " + фио0);
	
	возврат стру;
	
КонецФункции

Функция   ЗагрузитьИнформациюПоИнн(инн) Экспорт
	
	ю = СтрДлина(инн) = 10;
	ф = СтрДлина(инн) = 12;
	
	Если ю тогда
		урл = "https://api.orgregister.1c.ru/rest/corporation/v1/find-corporation-by-inn?inn=%1";
	ИначеЕсли ф Тогда
		урл = "https://api.orgregister.1c.ru/rest/person/v1/find-person-trustability-by-inn?inn=%1";
	Иначе
		возврат новый Структура("Ошибка", "Неправильный инн, д.б. 10 или 12 цифр");
	КонецЕсли;
	
	урл = СтрШаблон(урл, инн);
	
	логин_пароль = МойМдл.РеквизитыНастройки("ЛогинИТС,ПарольИТС");
	Если Не ЗначениеЗаполнено(логин_пароль.ЛогинИТС) или не ЗначениеЗаполнено(логин_пароль.ПарольИТС) Тогда
		возврат новый Структура("Ошибка", "Не заполнены в настройках логин или пароль для ИТС");
	КонецЕсли;
	
	количество_попыток = 1;
	Пока Истина Цикл
		
		стру_ответ = ЗапростьДанные(урл, логин_пароль.ЛогинИТС, логин_пароль.ПарольИТС);
		
		Если стру_ответ.КодСостояния <> 200 Тогда
			возврат новый Структура("Ошибка", Строка(стру_ответ.КодСостояния) + " " + Лев(стру_ответ.Текст, 100));
		КонецЕсли;
		
		стру_рав = РазобратьJSONвСтруктуру(стру_ответ.Текст);
		
		ожидание = ПутьЗначение(стру_рав, "awaitingResponse");
		ошибки = ПутьЗначение(стру_рав, "errors");
		
		Если ожидание = Неопределено и ошибки = Неопределено Тогда
			Если ю Тогда
				возврат КонвертФорматЮрЛицо(стру_рав);
			Иначе
				возврат КонвертФорматФизЛицо(стру_рав);
			КонецЕсли;
			
		ИначеЕсли ошибки <> Неопределено Тогда
			
			ма = новый Массив;
			Для Каждого ит из ошибки Цикл
				ма.Добавить(ПутьЗначение(ит, "message"));
			КонецЦикла;
			
			возврат новый Структура("Ошибка", СтрСоединить(ма, ", "));
			
		ИначеЕсли ожидание = Ложь Тогда
			возврат новый Структура("Ошибка", "Сервер ответил, что есть где-то ошибка, и ответа на запрос не будет (awaitingResponse=false)");
			
		ИначеЕсли количество_попыток = 3 Тогда
			возврат новый Структура("Ошибка", "Сервер ответил нужно подождать и запросить попозже (awaitingResponse=true)");
			
		Иначе
			МойМдл.СделатьПаузу(1000);
			количество_попыток = количество_попыток + 1;
			
		КонецЕсли;
		
	КонецЦикла;
	
	
	
	//СтруктураАдреса = УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(СтрАдрес);
	//УправлениеКонтактнойИнформацией.ЗаполнитьОбъектРедактированияАдресаПоСтруктуре(ЭтотОбъект, СтруктураАдреса);
	
КонецФункции


