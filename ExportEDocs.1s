
Функция   МножествоАдресныхСокращений(стру_док)
	
	кэш = Неопределено;
	Если стру_док.Свойство("__Кэш_АдресныеСокращения", кэш) Тогда
		возврат кэш;
	КонецЕсли;
	
	кэш = новый Структура;
	стру_док.Вставить("__Кэш_АдресныеСокращения", кэш);
	
	тхт = "
	|выбрать
	|	НазваниеСвойства,
	|	Сокращение,
	|	ЗаменаДляЭДО_вНачале,
	|	ЗаменаДляЭДО_вКонце
	|из
	|	Справочник.АдресныеСокращения
	|где
	|	не пометкаудаления";
	
	з = новый запрос(тхт);
	
	выб = з.Выполнить().Выбрать();
	пока выб.Следующий() цикл
		
		св = сокрЛП(выб.НазваниеСвойства);
		
		ма = Неопределено;
		Если НЕ кэш.Свойство(св, ма) Тогда
			ма = новый Соответствие;
			кэш.Вставить(св, ма);
		конецЕсли;
		
		зн = сокрЛП(выб.Сокращение);
		Если Прав(зн, 1) = "." Тогда
			зн = Лев(зн, СтрДлина(зн)-1);
		КонецЕсли;
		
		замена = новый Структура(
		"вНачале,вКонце",
		СокрЛП(выб.ЗаменаДляЭДО_вНачале),
		СокрЛП(выб.ЗаменаДляЭДО_вКонце)
		);
		
		ма.Вставить(зн, замена);
		ма.Вставить(зн + ".", замена);
		
	КонецЦикла;
	
	возврат кэш;
	
КонецФункции

Функция   КоличествоСимволовТестаСокращения(стр, ОтНачала=Истина)
	
	колич_тест_сокращения = 0;
	
	позиция_точки = 0;
	
	длин = СтрДлина(стр);
	
	Для н = 1 по длин Цикл
		
		Если ОтНачала Тогда
			си = Сред(стр, н, 1);
		Иначе
			си = Сред(стр, длин-н+1, 1);
		КонецЕсли;
		
		Если си = " " Тогда
			колич_тест_сокращения = н-1;
			прервать;
		ИначеЕсли позиция_точки > 0 Тогда
			колич_тест_сокращения = н-1;
			прервать;
		ИначеЕсли ОтНачала И си = "." Тогда
			позиция_точки = н;
		КонецЕсли;
	КонецЦикла;
	
	возврат колич_тест_сокращения;
	
КонецФункции

Функция   ДобавитьЗаменуАдресногоСокращения(Знач зн, замена)
	
	Если ЗначениеЗаполнено(замена.вНачале) Тогда
		зн = замена.вНачале + " " + зн;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(замена.вКонце) Тогда
		зн = зн + " " + замена.вКонце;
	КонецЕсли;
	
	возврат зн;
	
КонецФункции

Функция   ПолучитьСЗаменойАдресныхСокращений(стру_док, стру_адр, св)
	
	Если стру_адр = Неопределено Тогда
		возврат Неопределено;
	КонецЕсли;
	
	зн = Неопределено;
	Если НЕ стру_адр.Свойство(св, зн) Тогда
		возврат Неопределено;
	КонецЕсли;
	
	зн = СокрЛП(зн);
	
	стру_сокр = МножествоАдресныхСокращений(стру_док);
	
	ма_сокр = Неопределено;
	Если НЕ стру_сокр.Свойство(св, ма_сокр) Тогда
		возврат зн;
	КонецЕсли;
	
	колич_тест_сокращения = КоличествоСимволовТестаСокращения(зн, Истина);
	
	Если колич_тест_сокращения > 0 Тогда
		// сокращение в начале строки
		тест_сокращение = Лев(зн, колич_тест_сокращения);
		замена = ма_сокр.Получить(тест_сокращение);
		
		Если замена <> Неопределено Тогда
			зн = СокрЛ(Сред(зн, колич_тест_сокращения+1));
			возврат ДобавитьЗаменуАдресногоСокращения(зн, замена);
		КонецЕсли;
	КонецЕсли;
	
	колич_тест_сокращения = КоличествоСимволовТестаСокращения(зн, Ложь);
		
	Если колич_тест_сокращения > 0 Тогда
		// сокращение в конце строки
		тест_сокращение = Прав(зн, колич_тест_сокращения);
		замена = ма_сокр.Получить(тест_сокращение);
		
		Если замена <> Неопределено Тогда
			зн = СокрП(Лев(зн, СтрДлина(зн) - колич_тест_сокращения));
			возврат ДобавитьЗаменуАдресногоСокращения(зн, замена);
		КонецЕсли;
	КонецЕсли;
	
	возврат зн;
	
КонецФункции

Функция   ЗапросАдрес(юрфиз, ТипАдреса)
	
	ВидАдреса = ячсмТулсы.ЗначениеВидаАдреса(юрфиз, ТипАдреса);

	Запрос = Новый Запрос;
	Запрос.Текст = "                                       
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтактнаяИнформация.*
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Объект
	|	И КонтактнаяИнформация.Тип = &Тип
	|	И КонтактнаяИнформация.Вид = &Вид";
	
	Запрос.УстановитьПараметр("Объект", юрфиз);
	Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.Адрес);
	Запрос.УстановитьПараметр("Вид", ВидАдреса);
	
	рез = Запрос.Выполнить();
	Если рез.Пустой() Тогда
		возврат неопределено;
	КонецЕсли;
	
	выб = рез.Выбрать();
	выб.Следующий();
	
	рез = УправлениеКонтактнойИнформацией.ПолучитьПолныйАдресКакМассив(выб);
	
	возврат УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзМассива(рез);
	
КонецФункции

Функция   ЗапросКонтактнуюИнформацию(ссылка, тип_ки)

	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Объект", ссылка);
	Запрос.УстановитьПараметр("Тип"   , тип_ки);
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтактнаяИнформация.Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Объект
	|	И
	|	КонтактнаяИнформация.Тип = &Тип
	|";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ма = новый Массив;
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ма;
	КонецЕсли;
	
	выб = РезультатЗапроса.Выбрать();
	пока выб.Следующий() Цикл
		ма.Добавить(выб.Представление);
	КонецЦикла;
	
	Возврат ма;

КонецФункции

Функция   СделатьКонтактнуюИнформацию(ссылка, тип_ки, стру_док)
	
	кэш = Неопределено;
	Если НЕ стру_док.Свойство("__Кэш_КонтактнаяИнформация", кэш) Тогда
		кэш = новый Соответствие;
		стру_док.Вставить("__Кэш_КонтактнаяИнформация", кэш);
	КонецЕсли;
	
	ключ = ЗначениеВСтрокуВнутр(ссылка) + ЗначениеВСтрокуВнутр(тип_ки);
	
	рез = кэш.Получить(ключ);
	
	Если рез = Неопределено Тогда
		рез = ЗапросКонтактнуюИнформацию(ссылка, тип_ки);
		кэш.Вставить(ключ, рез);
	КонецЕсли;
	
	если рез.количество() = 0 Тогда
		возврат Неопределено;
	КонецЕсли;
	
	возврат рез;
	
КонецФункции

Функция   СделатьДату(дт)
	Возврат Формат(дт, "ДФ=dd.MM.yyyy");
КонецФункции

Функция   СделатьВремя(дт)
	возврат Формат(дт, "ДФ=чч.мм.сс");
КонецФункции

Функция   СделатьНомер(инфо_номер)
	
	// инфо_номер
	//  структура, или что-либо, содержащее поля Номер,?Организация?
	
	Возврат ОбщегоНазначения.ПолучитьНомерНаПечать(инфо_номер);
	
КонецФункции

Функция   СведенияОЮрФизЛице(стру_док, юрфиз, БанковскийСчет=Неопределено)
	
	кэш = Неопределено;
	Если НЕ стру_док.Свойство("__Кэш_СведенияОЮрФизЛице", кэш) Тогда
		кэш = новый Соответствие;
		стру_док.Вставить("__Кэш_СведенияОЮрФизЛице", кэш);
	КонецЕсли;
	
	рез = кэш.Получить(юрфиз);
	
	Если рез <> Неопределено Тогда
		возврат рез;
	КонецЕсли;
	
	рез = УправлениеКонтактнойИнформацией.СведенияОЮрФизЛице(юрфиз, стру_док.Дата,, БанковскийСчет);
	
	рез.Вставить("СтруЮрАдр", ЗапросАдрес(юрфиз, "Юридический"));
	рез.Вставить("СтруФактАдр", ЗапросАдрес(юрфиз, "Фактический"));
	
	//рез.Вставить("СтруЮрАдр", УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(рез.ЮридическийАдрес));
	//рез.Вставить("СтруФактАдр", УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(рез.ФактическийАдрес));
	
	кэш.Вставить(юрфиз, рез);
	
	возврат рез;
	
КонецФункции

Функция   ЗапросНайтиКодРегиона(регион)
	
	тхт = "
	|выбрать
	|	КодРегиона
	|из
	|	Справочник.Регионы
	|где
	|	не ПометкаУдаления
	|	И Наименование = &назв";
	
	з = новый Запрос(тхт);
	з.УстановитьПараметр("назв", регион);
	
	рез = з.Выполнить();
	если рез.Пустой() тогда
		возврат "";
	КонецЕсли;
	
	выб = рез.Выбрать();
	пока выб.Следующий() цикл
		Если ЗначениеЗаполнено(выб.КодРегиона) Тогда
			возврат выб.КодРегиона;
		КонецЕсли;
	КонецЦикла;
	
	возврат "";
	
КонецФункции

Функция   СделатьКодРегиона(стру_док, регион)
	
	кэш = Неопределено;
	Если НЕ стру_док.Свойство("__Кэш_КодыРегионов", кэш) Тогда
		кэш = новый Соответствие;
		стру_док.Вставить("__Кэш_КодыРегионов", кэш);
	КонецЕсли;
	
	рез = кэш.Получить(регион);
	
	Если рез = Неопределено Тогда
		рез = ЗапросНайтиКодРегиона(регион);
		кэш.Вставить(регион, рез);
	КонецЕсли;
	
	Если не ЗначениеЗаполнено(рез) Тогда
		возврат неопределено;
	КонецЕсли;
	
	возврат рез;
	
КонецФункции

Функция   НайтиКодРегионаБезКэширования(назв) Экспорт
	
	Если НЕ ЗначениеЗаполнено(назв) Тогда
		возврат Неопределено;
	КонецЕсли;
	
	адр = новый Структура("Регион", назв);
	
	кэши = новый Структура;
	
	значение = ПолучитьСЗаменойАдресныхСокращений(кэши, адр, "Регион");
	
	рез = ЗапросНайтиКодРегиона(значение);
	
	Если не ЗначениеЗаполнено(рез) Тогда
		возврат Неопределено;
	КонецЕсли;
	
	возврат рез;
	
КонецФункции

Функция   ДобавитьСвойствоАдреса(оАдрРф, стру_док, адр, рез_св, исх_св = Неопределено)
	
	Если исх_св = Неопределено Тогда
		исх_св = рез_св;
	КонецЕсли;
	
	значение = ПолучитьСЗаменойАдресныхСокращений(стру_док, адр, исх_св);
	
	Если ЗначениеЗаполнено(значение) Тогда
		оАдрРф[рез_св] = значение;
		возврат значение;
	КонецЕсли;
	
	возврат Неопределено;
	
КонецФункции

Функция   ДобавитьКодРегиона(оАдрРф, стру_док, Регион)
	
	Если ЗначениеЗаполнено(Регион) Тогда
		КодРегион = СделатьКодРегиона(стру_док, Регион);
		Если ЗначениеЗаполнено(КодРегион) Тогда
			оАдрРф.КодРегион = КодРегион;
			возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция   СоздатьАдрес(пак, адр, стру_док)
	
	оАдр = ФабрикаXDTO.Создать(пак.Получить("АдресТип"));
	
	// УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(...)
	//   -> РегламентированнаяОтчетность.РазложитьАдрес(...)
	
	//СтруктураВозврата.Вставить("Страна",Страна);
	//СтруктураВозврата.Вставить("Индекс",Индекс);
	//СтруктураВозврата.Вставить("Регион",Регион);
	//СтруктураВозврата.Вставить("Район",Район);
	//СтруктураВозврата.Вставить("Город",Город);
	//СтруктураВозврата.Вставить("НаселенныйПункт",НаселенныйПункт);
	//СтруктураВозврата.Вставить("Улица",Улица);
	//СтруктураВозврата.Вставить("Дом",Дом);
	//СтруктураВозврата.Вставить("Корпус",Корпус);
	//СтруктураВозврата.Вставить("Квартира",Квартира);
	
	оАдрРф = ФабрикаXDTO.Создать(пак.Получить("АдрРФТип"));
	
	представление = "";
	Если адр.Свойство("Представление", представление) Тогда
		
		оАдрРф.ИныеСвед = представление;
		
	Иначе
		
		ДобавитьСвойствоАдреса(оАдрРф, стру_док, адр, "Индекс");
		
		значение = ПолучитьСЗаменойАдресныхСокращений(стру_док, адр, "Город");
		Если значение = "Москва" или значение = "Санкт-Петербург" или значение = "Севастополь" Тогда
			оАдрРф.НаимРегион = значение;
			Регион = значение;
			Город = Неопределено;
		Иначе
			Регион   = ДобавитьСвойствоАдреса(оАдрРф, стру_док, адр, "НаимРегион", "Регион");
			Город    = ДобавитьСвойствоАдреса(оАдрРф, стру_док, адр, "Город");
		КонецЕсли;
		
		ДобавитьСвойствоАдреса(оАдрРф, стру_док, адр, "Район");
		ДобавитьСвойствоАдреса(оАдрРф, стру_док, адр, "НаселПункт", "НаселенныйПункт");
		
		Если НЕ ДобавитьКодРегиона(оАдрРф, стру_док, Регион) Тогда
			ДобавитьКодРегиона(оАдрРф, стру_док, Город);
		КонецЕсли;
		
		ДобавитьСвойствоАдреса(оАдрРф, стру_док, адр, "Улица");
		ДобавитьСвойствоАдреса(оАдрРф, стру_док, адр, "Дом");
		ДобавитьСвойствоАдреса(оАдрРф, стру_док, адр, "Корпус");
		ДобавитьСвойствоАдреса(оАдрРф, стру_док, адр, "Кварт", "Квартира");
		
	КонецЕсли;
	
	оАдр.АдрРФ = оАдрРф;
	
	возврат оАдр;
	
КонецФункции

Функция   СоздатьБанкРекв(пак, стру_юф)
	
	тпБанкРекв = пак.Получить("УчастникТип").Свойства.Получить("БанкРекв").Тип;
	
	оБанкРекв = ФабрикаXDTO.Создать(тпБанкРекв);
	
	оБанкРекв.НомерСчета = стру_юф.НомерСчета;
	
	оСвБанк = ФабрикаXDTO.Создать(тпБанкРекв.Свойства.Получить("СвБанк").Тип);
	
	Если ЗначениеЗаполнено(стру_юф.БИК) Тогда
		оСвБанк.БИК = стру_юф.БИК;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(стру_юф.КоррСчет) Тогда
		оСвБанк.КорСчет = стру_юф.КоррСчет;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(стру_юф.Банк) Тогда
		НазвБанка = ГетРекв(стру_юф.Банк, "Наименование");
		Если ЗначениеЗаполнено(НазвБанка) Тогда
			оСвБанк.НаимБанк = НазвБанка;
		КонецЕсли;
	КонецЕсли;
	
	оБанкРекв.СвБанк = оСвБанк;
	
	возврат оБанкРекв;
	
КонецФункции

Функция   СоздатьКонтакт(пак, юрфиз, стру_док)
	
	ма_тел = СделатьКонтактнуюИнформацию(юрфиз, Перечисления.ТипыКонтактнойИнформации.Телефон, стру_док);
	
	ма_майлы = СделатьКонтактнуюИнформацию(юрфиз, Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты, стру_док);
	
	Если ма_тел = Неопределено И ма_майлы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	оКонтакт = ФабрикаXDTO.Создать(пак.Получить("КонтактТип"));
	
	Если ма_тел <> Неопределено Тогда
		Для каждого тел из ма_тел Цикл
			оКонтакт.Тлф.Добавить(тел);
		КонецЦикла;
	КонецЕсли;
	
	Если ма_майлы <> Неопределено Тогда
		Для каждого майл из ма_майлы Цикл
			оКонтакт.ЭлПочта.Добавить(майл);
		КонецЦикла;
	КонецЕсли;
	
	Возврат оКонтакт;
	
КонецФункции

Функция   СоздатьСвЮЛУч(пак, стру_юф)
	
	тп = пак.Получить("УчастникТип").Свойства.Получить("ИдСв").Тип.Свойства.Получить("СвЮЛУч").Тип;
	
	рез = ФабрикаXDTO.Создать(тп);
	
	Если ЗначениеЗаполнено(стру_юф.ПолноеНаименование) Тогда
		рез.НаимОрг = стру_юф.ПолноеНаименование;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(стру_юф.ИНН) Тогда
		рез.ИННЮЛ = стру_юф.ИНН;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(стру_юф.КПП) Тогда
		рез.КПП = стру_юф.КПП;
	КонецЕсли;
	
	возврат рез;
	
КонецФункции

Функция   СделатьФИО(Название)
	
	ма = СтрРазделить(Название, " ", Ложь);
	Если ма.Количество() < 3 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Пока ма.Количество() > 3 Цикл
		вгр = ма.ВГраница();
		сс = ма.Получить(вгр);
		Если НЕ МойМдл.ПроверитьСодержитТолько(сс, "0123456789+-()") Тогда
			прервать;
		КонецЕсли;
		ма.Удалить(вгр);
	КонецЦикла;
	
	Если НРег(ма.Получить(0)) = "ип" Тогда
		ма.Удалить(0);
	КонецЕсли;
	
	вгр = ма.ВГраница();
	Если НРег(ма.Получить(вгр)) = "ип" Тогда
		ма.Удалить(вгр);
	КонецЕсли;
	
	Если ма.Количество() <> 3 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Фамилия = ма.Получить(0);
	Имя = ма.Получить(1);
	Отчество = ма.Получить(2);
	
	Если НЕ МойМдл.ТестТолькоРусскиеБуквы(Фамилия) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ МойМдл.ТестТолькоРусскиеБуквы(Имя) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ МойМдл.ТестТолькоРусскиеБуквы(Отчество) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	стру = новый Структура("Фамилия,Имя,Отчество", Фамилия, Имя, Отчество);
	
	возврат стру;
	
КонецФункции

Функция   СоздатьФИО(пак, Название)
	
	стру_фио = СделатьФИО(Название);
	
	Если стру_фио = Неопределено Тогда
		возврат Неопределено;
	КонецЕсли;
	
	оФио = ФабрикаXDTO.Создать(пак.Получить("ФИОТип"));
	оФио.Фамилия = стру_фио.Фамилия;
	оФио.Имя = стру_фио.Имя;
	оФио.Отчество = стру_фио.Отчество;
	
	возврат оФио;
	
КонецФункции

Функция   СоздатьСвИП(пак, стру_юф)
	
	тп = пак.Получить("УчастникТип").Свойства.Получить("ИдСв").Тип.Свойства.Получить("СвИП").Тип;
	
	рез = ФабрикаXDTO.Создать(тп);
	
	Если ЗначениеЗаполнено(стру_юф.ИНН) Тогда
		рез.ИННФЛ = стру_юф.ИНН;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(стру_юф.ОГРН) Тогда
		рез.ОГРНИП = стру_юф.ОГРН;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(стру_юф.СвидетельствоСерияНомер) Тогда
		рез.СвГосРегИП = стру_юф.СвидетельствоСерияНомер;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(стру_юф.СвидетельствоДатаВыдачи) Тогда
		рез.ДатаОГРНИП = стру_юф.СвидетельствоДатаВыдачи;
	КонецЕсли;
	
	оФио = СоздатьФио(пак, стру_юф.ПолноеНаименование);
	Если оФио <> Неопределено Тогда
		рез.ФИО = оФио;
	КонецЕсли;
	
	возврат рез;
	
КонецФункции

Функция   СоздатьРеквизитыЮрФизЛица(пак, стру_юф)
	
	тпИдСв = пак.Получить("УчастникТип").Свойства.Получить("ИдСв").Тип;
	
	о = ФабрикаXDTO.Создать(тпИдСв);
	
	Если стру_юф.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		о.СвЮЛУч = СоздатьСвЮЛУч(пак, стру_юф);
		
	ИначеЕсли стру_юф.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		о.СвИП = СоздатьСвИП(пак, стру_юф);
		
	КонецЕсли;
	
	возврат о;
	
КонецФункции

Функция   СоздатьУчастникТип(пак, стру_док, юрфиз)
	
	стру_юф = СведенияОЮрФизЛице(стру_док, юрфиз);
	
	//Сведения.Вставить("Представление",    Данные.Наименование);
	//Сведения.Вставить("ИНН",              Данные.ИНН);
	//Сведения.Вставить("Телефоны",         ПолучитьТелефонИзКонтактнойИнформации(ЮрФизЛицо));
	//Сведения.Вставить("НомерСчета",       Данные.НомерСчета);
	//Сведения.Вставить("Банк",             Данные.Банк);
	//Сведения.Вставить("БИК",              Данные.БИК);
	//Сведения.Вставить("АдресБанка",       Данные.АдресБанка);
	//Сведения.Вставить("КоррСчет",         Данные.КоррСчет);
	//Сведения.Вставить("ЮридическийАдрес", ПолучитьАдресИзКонтактнойИнформации(ЮрФизЛицо,"Юридический"));
	//Сведения.Вставить("ФактическийАдрес", ПолучитьАдресИзКонтактнойИнформации(ЮрФизЛицо,"Фактический"));
	
	тп = пак.Получить("УчастникТип");
	
	рез = ФабрикаXDTO.Создать(тп);
	
	Если ЗначениеЗаполнено(стру_юф.КодПоОКПО) Тогда
		рез.ОКПО = стру_юф.КодПоОКПО;
	КонецЕсли;
	
	Если СтрДлина(стру_юф.ПолноеНаименование) >= 4 Тогда
		рез.ПолнНаимОПФ = стру_юф.ПолноеНаименование;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(стру_юф.Представление) Тогда
		рез.СокрНаим = стру_юф.Представление;
	КонецЕсли;
	
	адр = стру_юф.СтруЮрАдр;
	Если адр = Неопределено Тогда
		адр = стру_юф.СтруФактАдр;
	КонецЕсли;
	
	Если адр <> Неопределено Тогда
		рез.Адрес = СоздатьАдрес(пак, адр, стру_док);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(стру_юф.НомерСчета) Тогда
		рез.БанкРекв = СоздатьБанкРекв(пак, стру_юф);
	КонецЕсли;
	
	оКонтакт = СоздатьКонтакт(пак, юрфиз, стру_док);
	Если оКонтакт <> Неопределено Тогда
		рез.Контакт = оКонтакт;
	КонецЕсли;
	
	рез.ИдСв = СоздатьРеквизитыЮрФизЛица(пак, стру_юф);
	
	возврат рез;
	
КонецФункции

Функция   СоздатьРеквДокТип(пак, назв, дт, номер)
	
	рез = ФабрикаXDTO.Создать( пак.Получить("РеквДокТип") );
	
	рез.РеквНаимДок = назв;
	
	Если ЗначениеЗаполнено(дт) Тогда
		рез.РеквДатаДок = СделатьДату(дт);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(номер) Тогда
		рез.РеквНомерДок = СделатьНомер(номер);
	КонецЕсли;
	
	Возврат рез;
	
КонецФункции

Функция   СоздатьРеквДокТип_ПоДокументу(пак, ссылка)
	
	назв = ссылка.Метаданные().Синоним;
	
	стру = ГетСписок(ссылка, "Номер,Дата,Организация");
	
	Возврат СоздатьРеквДокТип(пак, назв, стру.Дата, стру);
	
КонецФункции

Функция   СоздатьСчФакт(пак, свСвСчФакт, стру_док)
	
	оСвСчФакт = ФабрикаXDTO.Создать(свСвСчФакт.Тип);
	
	счф = УчетНДС.НайтиПодчиненныйДокумент(стру_док.Ссылка, "СчетФактураВыданный");
	Если ЗначениеЗаполнено(счф) Тогда
		стру_счф = ГетСписок(счф, "Номер,Дата,Организация");
		оСвСчФакт.ДатаДок = СделатьДату(стру_счф.Дата);
		оСвСчФакт.НомерДок = СделатьНомер(стру_счф);
	КонецЕсли;
	
	оСвСчФакт.СвПрод.Добавить(СоздатьУчастникТип(пак, стру_док, стру_док.Организация));
	
	оСвСчФакт.СвПокуп.Добавить(СоздатьУчастникТип(пак, стру_док, стру_док.Контрагент));
	
	Если НЕ ЗначениеЗаполнено(стру_док.Грузоотправитель) Тогда
		ГрузОтпр = стру_док.Организация
	Иначе
		ГрузОтпр = стру_док.Грузоотправитель
	КонецЕсли;
	
	оГрузОт = ФабрикаXDTO.Создать(свСвСчФакт.Тип.Свойства.Получить("ГрузОт").Тип);
	
	Если ГрузОтпр = стру_док.Организация Тогда
		оГрузОт.ОнЖе = "он же";
	Иначе
		оГрузОт.ГрузОтпр = СоздатьУчастникТип(пак, стру_док, ГрузОтпр);
	КонецЕсли;
	
	оСвСчФакт.ГрузОт.Добавить(оГрузОт);
	
	Если НЕ ЗначениеЗаполнено(стру_док.Грузополучатель) Тогда
		ГрузПолуч = стру_док.Контрагент;
	Иначе
		ГрузПолуч = стру_док.Грузополучатель
	КонецЕсли;
	
	оСвСчФакт.ГрузПолуч.Добавить(СоздатьУчастникТип(пак, стру_док, ГрузПолуч));
	
	оСвСчФакт.ДенИзм = ФабрикаXDTO.Создать(свСвСчФакт.Тип.Свойства.Получить("ДенИзм").Тип);
	оСвСчФакт.ДенИзм.КодОКВ = "643";
	оСвСчФакт.ДенИзм.НаимОКВ = "Российский рубль";
	
	оСвСчФакт.ДокПодтвОтгрНом.Добавить(СоздатьРеквДокТип(пак, "Универсальный передаточный документ", стру_док.Дата, стру_док));
	
	//<ИнфПолФХЖ1>
	//  <ТекстИнф Значен="1" Идентиф="ДоговорНомер"/>
	//  <ТекстИнф Значен="10.03.2026" Идентиф="ДоговорДата"/>
	//  <ТекстИнф Значен="2055" Идентиф="СкладКод"/>
	//  <ТекстИнф Значен="Магазин &quot;Сапожок&quot;" Идентиф="СкладНаименование"/>
	//  <ТекстИнф Значен="https://docs.saby.ru/opendoc.html?guid=c88c596d-9dda-43f7-9762-7c525affd989&amp;org=171&amp;f3=171&amp;file=c64d1091-5f00-4b60-b13c-5f7f04864ade&amp;ver=1&amp;date=20260401083956&amp;client=22" Идентиф="Документ.СсылкаНаВложение"/>
	//</ИнфПолФХЖ1>
	
	Возврат оСвСчФакт;
	
КонецФункции

Функция   ЗапросТабличнаяЧасть(Док)
	
	тхт = "
	|выбрать
	|	тт.Количество
	|	
	|из
	|	Документ.РеализацияТоваровУслуг.Товары как тт
	|где
	|	тт.Ссылка = &Ссылка";
	
КонецФункции

Функция   СоздатьСведТов(пак, свТаблСчФакт, стру_стч, НомСтр)
	
	свСведТов = свТаблСчФакт.Тип.Свойства.Получить("СведТов");
	свДопСведТов = свСведТов.Тип.Свойства.Получить("ДопСведТов");
	
	оАкциз = ФабрикаXDTO.Создать(пак.Получить("СумАкцизТип"));
	оАкциз.БезАкциз = "без акциза";
	
	оДопСведТов = ФабрикаXDTO.Создать(свДопСведТов.Тип);
	оДопСведТов.КодТов = стру_стч.ТоварКод;
	
	Если стру_стч.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар Тогда
		оДопСведТов.ПрТовРаб = 1;
	ИначеЕсли стру_стч.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга Тогда
		оДопСведТов.ПрТовРаб = 3;
	Иначе
		оДопСведТов.ПрТовРаб = 1;
	КонецЕсли;
	
	рез = ФабрикаXDTO.Создать(свСведТов.Тип);
	
	Если стру_стч.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
		НалСт = "без НДС";
	Иначе
		НалСт = Строка(стру_стч.СтавкаНДС);
	КонецЕсли;
	
	оСумНал = ФабрикаXDTO.Создать(пак.Получить("СумНДСТип"));
	Если НалСт = "без НДС" Тогда
		оСумНал.БезНДС = "без НДС";
	Иначе
		оСумНал.СумНал = стру_стч.СуммаНДС;
	КонецЕсли;
	
	рез.НомСтр = НомСтр;
	рез.НаимТов = стру_стч.ТоварНаименование;
	рез.ОКЕИ_Тов = стру_стч.БазоваяЕдиницаКодПоОКЕИ;
	рез.НаимЕдИзм = стру_стч.БазоваяЕдиницаНаименование;
	рез.КолТов = стру_стч.Количество;
	рез.ЦенаТов = стру_стч.ЦенаБезНДС;
	рез.СтТовБезНДС = стру_стч.СуммаБезНДС;
	рез.НалСт = НалСт;
	рез.СтТовУчНал = стру_стч.СуммаСНДС;
	
	рез.Акциз = оАкциз;
	рез.СумНал = оСумНал;
	рез.ДопСведТов = оДопСведТов;
	
	возврат рез;
	
КонецФункции

Функция   СоздатьВсегоОпл(пак, свТаблСчФакт, стру_док_2)
	
	рез = ФабрикаXDTO.Создать(свТаблСчФакт.Тип.Свойства.Получить("ВсегоОпл").Тип);
	
	рез.СтТовБезНДСВсего = стру_док_2.Товары.Итог("СуммаБезНДС");
	
	рез.СтТовУчНалВсего = стру_док_2.Товары.Итог("СуммаСНДС");
	
	рез.КолНеттоВс = стру_док_2.Товары.Итог("Количество");
	
	все_без_ндс = Истина;
	Для каждого стр из стру_док_2.Товары Цикл
		Если стр.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС Тогда
			все_без_ндс = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	оСумНалВсего = ФабрикаXDTO.Создать(пак.Получить("СумНДСТип"));
	Если все_без_ндс Тогда
		оСумНалВсего.БезНДС = "без НДС";
	Иначе
		оСумНалВсего.СумНал = стру_док_2.Товары.Итог("СуммаНДС");
	КонецЕсли;
	
	рез.СумНалВсего = оСумНалВсего;
	
	возврат рез;
	
КонецФункции

Функция   СоздатьТаблСчФакт(пак, стру_док_2, свТаблСчФакт)
	
	оТаблСчФакт = ФабрикаXDTO.Создать(свТаблСчФакт.Тип);
	
	НомСтр = 1;
	Для каждого стр_тч из стру_док_2.Товары Цикл
		
		оТаблСчФакт.СведТов.Добавить(СоздатьСведТов(пак, свТаблСчФакт, стр_тч, НомСтр));
		
		НомСтр = НомСтр + 1;
		
	КонецЦикла;
	
	оТаблСчФакт.ВсегоОпл = СоздатьВсегоОпл(пак, свТаблСчФакт, стру_док_2);
	
	возврат оТаблСчФакт;
	
КонецФункции

Функция   СоздатьСвПродПер(пак, свДокумент, стру_док, стру_док_2)
	
	есть_услуги = Ложь;
	есть_товары = Ложь;
	
	Для каждого стр из стру_док_2.Товары Цикл
		Если стр.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга Тогда
			есть_услуги = Истина;
		Иначе
			есть_товары = Истина;
		КонецЕсли;
	КонецЦикла;
	
	свСвПродПер = свДокумент.Тип.Свойства.Получить("СвПродПер");
	
	рез = ФабрикаXDTO.Создать(свСвПродПер.Тип);
	
	оСвПер = ФабрикаXDTO.Создать(свСвПродПер.Тип.Свойства.Получить("СвПер").Тип);
	
	оСвПер.ДатаПер = СделатьДату(стру_док.Дата);
	
	Если есть_товары и не есть_услуги Тогда
		оСвПер.СодОпер = "Товары переданы";
	ИначеЕсли есть_услуги и не есть_товары Тогда
		оСвПер.СодОпер = "Услуги оказаны в полном объеме";
	ИначеЕсли есть_товары и есть_услуги Тогда
		оСвПер.СодОпер = "Товары переданы, услуги оказаны в полном объеме";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(стру_док_2.Шапка.Сделка) Тогда
		оОснПер = СоздатьРеквДокТип_ПоДокументу(пак, стру_док_2.Шапка.Сделка);
	Иначе
		оОснПер = СоздатьРеквДокТип(
		пак, Строка(стру_док_2.Шапка.Основание), Неопределено, Неопределено);
	КонецЕсли;
	
	оСвПер.ОснПер.Добавить(оОснПер);
	
	рез.СвПер = оСвПер;
	
	возврат рез;
	
КонецФункции

Функция   СоздатьПодписант(пак, свДокумент, стру_док, стру_док_2)
	
	тпПодписант = свДокумент.Тип.Свойства.Получить("Подписант").Тип;
	
	рез = ФабрикаXDTO.Создать(тпПодписант);
	
	Если ЗначениеЗаполнено(стру_док_2.РуководительДолжность) Тогда
		рез.Должн = стру_док_2.РуководительДолжность;
	КонецЕсли;
	
	рез.ФИО = СоздатьФио(пак, стру_док_2.РуководительФиоПолное);
	
	рез.СпосПодтПолном = 1;
	
	возврат рез;
	
КонецФункции

Функция   СделатьИдЮрФиз(стру_док, юрфиз)
	
	стру_инфо = СведенияОЮрФизЛице(стру_док, юрфиз);
	
	кпп = "";
	Если ЗначениеЗаполнено(стру_инфо.КПП) Тогда
		кпп = "-" + стру_инфо.КПП;
	КонецЕсли;
	
	возврат "2BE" + стру_инфо.ИНН + кпп;
	
КонецФункции

Функция   СделатьИдФайл(стру_док)
	
	КонтрольДвиженияТовара = "";
	
	ИдентификаторПолучателя = СделатьИдЮрФиз(стру_док, стру_док.Контрагент);
	ИдентификаторОтправителя = СделатьИдЮрФиз(стру_док, стру_док.Организация);
	
	ДатаФормирования = ТекущаяДата();
	
	УникальныйИдентификатор = стру_док.Ссылка.УникальныйИдентификатор();
	
	ИдентификаторФайла = СтрШаблон("ON_NSCHFDOPPR%1_%2_%3_%4_%5",
		КонтрольДвиженияТовара, 
		ИдентификаторПолучателя,
		ИдентификаторОтправителя,
		Формат(ДатаФормирования, "ДФ=yyyyMMdd"),
		УникальныйИдентификатор);
		
	возврат ИдентификаторФайла;
		
КонецФункции

Функция   СделатьИмяФайлДляСохранения(стру_док, стру_док_2)
	
	стру_юф = СведенияОЮрФизЛице(стру_док, стру_док.Контрагент);
	
	су = стру_док_2.Товары.Итог("Сумма");
	
	им1 = Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd");
	им2 = СокрЛП(Лев(стру_юф.Представление, 30));
	им3 = Формат(су, "ЧРД=-; ЧГ=0");
	
	им1 = им1 + " " + им2 + " " + им3;
	
	убрать = "\/:*?""'<>|,";
	
	им1 = СтрСоединить(СтрРазделить(им1, убрать, Ложь), "");
	
	возврат им1 + ".xml";
	
КонецФункции

Функция   СделатьФайл(Док)
	
	стру_док = ГетСписок(Док,
	"Ссылка,
	|Организация,Контрагент,
	|ячсмДатаСоздания,
	|Грузоотправитель,Грузополучатель,Номер,Дата,БанковскийСчетОрганизации,Склад");
	
	стру_орг = СведенияОЮрФизЛице(стру_док, стру_док.Организация, стру_док.БанковскийСчетОрганизации);
	
	пак = ФабрикаXDTO.Пакеты.Получить("ON_NSCHFDOPPR_1_997_01_05_03_01");
	свФайл = пак.КорневыеСвойства.Получить("Файл");
	свДокумент = свФайл.Тип.Свойства.Получить("Документ");
	свСвСчФакт = свДокумент.Тип.Свойства.Получить("СвСчФакт");
	свТаблСчФакт = свДокумент.Тип.Свойства.Получить("ТаблСчФакт");
	
	оФайл = ФабрикаXDTO.Создать(свФайл.Тип);
	
	оФайл.ИдФайл = СделатьИдФайл(стру_док);
	оФайл.ВерсФорм = "5.03";
	оФайл.ВерсПрог = "1С83";
	
	оФайл.Документ = ФабрикаXDTO.Создать(свДокумент.Тип);
	
	оФайл.Документ.ВремИнфПр = СделатьВремя(стру_док.ячсмДатаСоздания);
	оФайл.Документ.ДатаИнфПр = СделатьДату(стру_док.ячсмДатаСоздания);
	оФайл.Документ.Функция = "СЧФДОП";
	оФайл.Документ.КНД = "1115131";
	оФайл.Документ.НаимДокОпр = "Универсальный передаточный документ";
	оФайл.Документ.ПоФактХЖ = "Документ об отгрузке товаров (выполнении работ), передаче имущественных прав (документ об оказании услуг)";
	
	оФайл.Документ.НаимЭконСубСост = ФормированиеПечатныхФорм.ОписаниеОрганизации(стру_орг, "ПолноеНаименование");
	оФайл.Документ.ДатаИнфПр = СделатьДату(стру_док.Дата);
	
	//оФайл.Документ.ВремИнфПр = "";
	
	оФайл.Документ.СвСчФакт = СоздатьСчФакт(пак, свСвСчФакт, стру_док);
	
	стру_док_2 = РасчетПечатиРеализации.ЗапросТаблицаРеализацииДляПечатнойФормы(стру_док, Ложь);
	
	оФайл.Документ.ТаблСчФакт = СоздатьТаблСчФакт(пак, стру_док_2, свТаблСчФакт);
	
	оФайл.Документ.СвПродПер = СоздатьСвПродПер(пак, свДокумент, стру_док, стру_док_2);
	
	оПодписант = СоздатьПодписант(пак, свДокумент, стру_док, стру_док_2);
	Если оПодписант <> Неопределено Тогда
		оФайл.Документ.Подписант.Добавить(оПодписант);
	КонецЕсли;
	
	имя_файла = СделатьИмяФайлДляСохранения(стру_док, стру_док_2);
	
	возврат новый Структура("Файл,ИмяФайла", оФайл, имя_файла);
	
КонецФункции

Процедура СделатьЭдоУпд(СсылкаРеализацияТоваровУслуг) Экспорт
	
	кат_выгрузки = ГетРекв(ПараметрыСеанса.ТекущийПользователь, "КаталогОбмена");
	Если не значениеЗаполнено(кат_выгрузки) Тогда
		сообщить("не указан каталог выгрузки");
		возврат;
	КонецЕсли;
	
	стру = СделатьФайл(СсылкаРеализацияТоваровУслуг);
	
	оФайл = стру.Файл;
	
	Запись = Новый ЗаписьXML;
	
	Если Прав(кат_выгрузки, 1) <> "\" Тогда
		кат_выгрузки = кат_выгрузки + "\";
	КонецЕсли;
	
	имя_файла_результата = кат_выгрузки + стру.ИмяФайла;
	
	Запись.УстановитьСтроку("WINDOWS-1251");
	
    Запись.ЗаписатьОбъявлениеXML();
	
    ФабрикаXDTO.ЗаписатьXML(Запись, оФайл, "Файл");
	
    стр = Запись.Закрыть();
	
	стр = СтрЗаменить(стр, "xmlns=""ON_NSCHFDOPPR_1_997_01_05_03_01""", "");
	стр = СтрЗаменить(стр, "xmlns:xs=""http://www.w3.org/2001/XMLSchema""", "");
	стр = СтрЗаменить(стр, "xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance""", "");
	
	си = Символы.ПС;
	си = си + си + си;
	стр = СтрЗаменить(стр, си, "");
	
	тхт = новый ТекстовыйДокумент;
	тхт.УстановитьТекст(стр);
	тхт.Записать(имя_файла_результата, "WINDOWS-1251");
	
	ф = новый Файл(имя_файла_результата);
	Если ф.Существует() Тогда
		сообщить("файл записан: "+имя_файла_результата);
	Иначе
		сообщить("Ошибка записи файла: "+имя_файла_результата);
	КонецЕсли;
	
КонецПроцедуры
